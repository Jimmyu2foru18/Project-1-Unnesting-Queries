# Secrets. .env is written by scripts/configure_keys.py and must never be committed.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Data and generated databases
data/
*.duckdb
*.duckdb.wal
*.sqlite
*.db

# The dump is fetched, not vendored. Delete this line if you intend to keep it.
imdb.7z

# Generated experiment output. Reports are run-specific.
benchmarks/results/

# Workload output produced by `sqlrewriter rewrite`.
workloads/*/rewrites.sql

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db