# Copy to .env and fill in what you need. Only one model provider is required.
# scripts/configure_keys.py writes this file for you and never prints secret values.

# --- Model providers -----------------------------------------------------------

# Local Ollama. Needs no key at all.
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_HOST=http://localhost:11434

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=

# Google Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro

# Default reasoning effort for the planning turn: low, medium or high.
# SQLRW_EFFORT=medium

# --- Database ------------------------------------------------------------------

# Engine used when none is given: postgres, mysql or duckdb.
SQLRW_ENGINE=duckdb

# Connection string. For DuckDB this is a file path, or :memory:.
SQLRW_DSN=data/imdb.duckdb

# PostgreSQL
# SQLRW_DSN=postgresql://user:password@localhost:5432/imdb

# MySQL
# SQLRW_DSN=mysql://user:password@localhost:3306/imdb